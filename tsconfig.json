{
  "compilerOptions": {
    "declaration": true,
    "target": "ES6",
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": "lib",
    "strict": true,
    "lib": [
      "esnext"
    ],
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "lib"
  ]
}
